  <script>
    const k = 8.9875517923e9;
    const tools = {
      force:{title:'Fuerza eléctrica entre dos cargas',formula:'F = k · |q₁ · q₂| / r²', fields:[['q1','Carga q₁ (C)','Ej.: 2e-6'],['q2','Carga q₂ (C)','Ej.: -3e-6'],['r','Distancia r (m)','Ej.: 0.25']], calc:v=>{const f=k*Math.abs(v.q1*v.q2)/v.r**2; return output(`F = ${fmt(f)} N`,[`F = k · |q₁ · q₂| / r²`,`F = ${sci(k)} · |${sci(v.q1)} · ${sci(v.q2)}| / (${fmt(v.r)})²`,`F = ${fmt(f)} N`],`${v.q1*v.q2>0?'Repulsión: las cargas tienen el mismo signo.':'Atracción: las cargas tienen signos opuestos.'}`,'q₁  ←── F ──→  q₂\n   r = '+fmt(v.r)+' m');}},
      charge1:{title:'Carga q₁',formula:'q₁ = F · r² / (k · |q₂|)', fields:[['f','Fuerza F (N)','Ej.: 0.5'],['q2','Carga q₂ (C)','Ej.: 3e-6'],['r','Distancia r (m)','Ej.: 0.2']], calc:v=>{const q=v.f*v.r**2/(k*Math.abs(v.q2)); return output(`|q₁| = ${sci(q)} C`,['q₁ = F · r² / (k · |q₂|)',`q₁ = ${fmt(v.f)} · (${fmt(v.r)})² / (${sci(k)} · |${sci(v.q2)}|)`,`|q₁| = ${sci(q)} C`],'La fórmula entrega la magnitud. Determina el signo con la información de atracción o repulsión.','q₁  ←── r ──→  q₂');}},
      charge2:{title:'Carga q₂',formula:'q₂ = F · r² / (k · |q₁|)', fields:[['f','Fuerza F (N)','Ej.: 0.5'],['q1','Carga q₁ (C)','Ej.: 3e-6'],['r','Distancia r (m)','Ej.: 0.2']], calc:v=>{const q=v.f*v.r**2/(k*Math.abs(v.q1)); return output(`|q₂| = ${sci(q)} C`,['q₂ = F · r² / (k · |q₁|)',`q₂ = ${fmt(v.f)} · (${fmt(v.r)})² / (${sci(k)} · |${sci(v.q1)}|)`,`|q₂| = ${sci(q)} C`],'La fórmula entrega la magnitud. Determina el signo según el tipo de interacción.','q₁  ←── r ──→  q₂');}},
      distance:{title:'Distancia entre cargas',formula:'r = √(k · |q₁ · q₂| / F)', fields:[['q1','Carga q₁ (C)','Ej.: 2e-6'],['q2','Carga q₂ (C)','Ej.: -3e-6'],['f','Fuerza F (N)','Ej.: 0.5']], calc:v=>{const r=Math.sqrt(k*Math.abs(v.q1*v.q2)/v.f); return output(`r = ${fmt(r)} m`,['r = √(k · |q₁ · q₂| / F)',`r = √(${sci(k)} · |${sci(v.q1)} · ${sci(v.q2)}| / ${fmt(v.f)})`,`r = ${fmt(r)} m`],'La distancia es siempre positiva.','q₁  ←──── r ────→  q₂');}},
      field:{title:'Campo eléctrico de una carga puntual',formula:'E = k · |Q| / r²', fields:[['q','Carga fuente Q (C)','Ej.: 5e-6'],['r','Distancia r (m)','Ej.: 0.3']], calc:v=>{const e=k*Math.abs(v.q)/v.r**2; return output(`E = ${fmt(e)} N/C`,['E = k · |Q| / r²',`E = ${sci(k)} · |${sci(v.q)}| / (${fmt(v.r)})²`,`E = ${fmt(e)} N/C`],`Dirección: ${v.q>0?'sale de':'apunta hacia'} la carga fuente.`,'Q  ─────── r ─────── ●\n       E '+(v.q>0?'→':'←'));}},
      net:{title:'Fuerza neta sobre una carga central',formula:'Fₙₑₜₐ = Fᵢzq + Fder (con dirección)', fields:[['qc','Carga central q (C)','Ej.: 2e-6'],['ql','Carga izquierda qᵢ (C)','Ej.: 3e-6'],['rl','Distancia izquierda rᵢ (m)','Ej.: 0.2'],['qr','Carga derecha qᵈ (C)','Ej.: -4e-6'],['rr','Distancia derecha rᵈ (m)','Ej.: 0.3']], calc:v=>{const fl=k*Math.abs(v.qc*v.ql)/v.rl**2, fr=k*Math.abs(v.qc*v.qr)/v.rr**2; const dl=(v.qc*v.ql>0?1:-1), dr=(v.qc*v.qr>0?1:-1); const net=fl*dl+fr*dr; return output(`Fₙₑₜₐ = ${fmt(Math.abs(net))} N hacia la ${net>=0?'derecha':'izquierda'}`,['Se calculan las magnitudes de cada interacción.',`F izquierda = ${fmt(fl)} N; F derecha = ${fmt(fr)} N`,`Con dirección: Fₙₑₜₐ = ${fmt(net)} N`],'Convención: derecha positiva. Las cargas están alineadas horizontalmente.',`qᵢ  ─ rᵢ ─  q  ─ rᵈ ─  qᵈ\n             ${net>=0?'→':'←'} Fₙₑₜₐ`);}},
      series:{title:'Resistencias en serie',formula:'Rₑq = R₁ + R₂ + R₃',fields:[['r1','Resistencia R₁ (Ω)','Ej.: 100'],['r2','Resistencia R₂ (Ω)','Ej.: 220'],['r3','Resistencia R₃ (Ω)','Ej.: 330']],calc:v=>{const r=v.r1+v.r2+v.r3; return output(`Rₑq = ${fmt(r)} Ω`,['Rₑq = R₁ + R₂ + R₃',`Rₑq = ${fmt(v.r1)} + ${fmt(v.r2)} + ${fmt(v.r3)}`,`Rₑq = ${fmt(r)} Ω`],'En serie la corriente es la misma en todas las resistencias.','series');}},
      parallel:{title:'Resistencias en paralelo',formula:'1 / Rₑq = 1/R₁ + 1/R₂ + 1/R₃',fields:[['r1','Resistencia R₁ (Ω)','Ej.: 100'],['r2','Resistencia R₂ (Ω)','Ej.: 220'],['r3','Resistencia R₃ (Ω)','Ej.: 330']],calc:v=>{const r=1/(1/v.r1+1/v.r2+1/v.r3); return output(`Rₑq = ${fmt(r)} Ω`,['1 / Rₑq = 1/R₁ + 1/R₂ + 1/R₃',`1 / Rₑq = 1/${fmt(v.r1)} + 1/${fmt(v.r2)} + 1/${fmt(v.r3)}`,`Rₑq = ${fmt(r)} Ω`],'En paralelo el voltaje es igual en cada rama.','parallel');}},
      mixed:{title:'Circuito mixto: serie y paralelo',formula:'Rₑq = R₁ + (R₂ ∥ R₃) + R₄',fields:[['r1','Resistencia R₁ en serie (Ω)','Ej.: 100'],['r2','Resistencia R₂, rama superior (Ω)','Ej.: 220'],['r3','Resistencia R₃, rama inferior (Ω)','Ej.: 330'],['r4','Resistencia R₄ en serie (Ω)','Ej.: 47']],calc:v=>{const rp=1/(1/v.r2+1/v.r3), r=v.r1+rp+v.r4; return output(`Rₑq = ${fmt(r)} Ω`,['Primero se resuelve el paralelo: R₂ ∥ R₃.',`R₂₋₃ = 1 / (1/${fmt(v.r2)} + 1/${fmt(v.r3)}) = ${fmt(rp)} Ω`,`Rₑq = R₁ + R₂₋₃ + R₄ = ${fmt(v.r1)} + ${fmt(rp)} + ${fmt(v.r4)}`,`Rₑq = ${fmt(r)} Ω`],'R₁ y R₄ están en serie con el bloque paralelo de R₂ y R₃.','mixed');}},
      ohm:{title:'Ley de Ohm',formula:'V = I · R',fields:[['mode','¿Qué deseas calcular?','', 'select', [['v','Voltaje V (V)'],['i','Corriente I (A)'],['r','Resistencia R (Ω)']]],['a','Primer valor','Ej.: 12'],['b','Segundo valor','Ej.: 2']],calc:v=>{let x,eq,steps; if(v.mode==='v'){x=v.a*v.b;eq='V = I · R';steps=[eq,`V = ${fmt(v.a)} · ${fmt(v.b)}`,`V = ${fmt(x)} V`];}else if(v.mode==='i'){x=v.a/v.b;eq='I = V / R';steps=[eq,`I = ${fmt(v.a)} / ${fmt(v.b)}`,`I = ${fmt(x)} A`];}else{x=v.a/v.b;eq='R = V / I';steps=[eq,`R = ${fmt(v.a)} / ${fmt(v.b)}`,`R = ${fmt(x)} Ω`];}return output(`${eq[0]} = ${fmt(x)} ${v.mode==='v'?'V':v.mode==='i'?'A':'Ω'}`,steps,'Para V ingresa I y R; para I ingresa V y R; para R ingresa V e I.','ohm');}},
      practice:{title:'Problemas de práctica de circuitos',formula:'Elige un problema y escribe solo el resultado numérico',fields:[['mode','Selecciona el problema','', 'select', [['p1','1. Serie: R₁=120 Ω, R₂=330 Ω, R₃=50 Ω'],['p2','2. Paralelo: R₁=100 Ω y R₂=100 Ω'],['p3','3. Ohm: V=12 V y R=6 Ω'],['p4','4. Mixto: R₁=10 Ω, R₂=20 Ω, R₃=20 Ω, R₄=5 Ω']]],['a','Tu respuesta','Ej.: 500']],calc:v=>{const data={p1:{x:500,u:'Ω',title:'Resistencia equivalente en serie',steps:['Rₑq = R₁ + R₂ + R₃','Rₑq = 120 + 330 + 50','Rₑq = 500 Ω'],d:'series'},p2:{x:50,u:'Ω',title:'Resistencia equivalente en paralelo',steps:['1/Rₑq = 1/100 + 1/100','Rₑq = 50 Ω'],d:'parallel'},p3:{x:2,u:'A',title:'Corriente del circuito',steps:['I = V / R','I = 12 / 6','I = 2 A'],d:'ohm'},p4:{x:25,u:'Ω',title:'Resistencia equivalente del circuito mixto',steps:['R₂ ∥ R₃ = 1 / (1/20 + 1/20) = 10 Ω','Rₑq = R₁ + (R₂ ∥ R₃) + R₄','Rₑq = 10 + 10 + 5 = 25 Ω'],d:'mixed'}}[v.mode], correct=Math.abs(v.a-data.x)<.01; return output(correct?'¡Correcto! Excelente trabajo.':`Aún no: tu respuesta fue ${fmt(v.a)} ${data.u}.`,[`Problema: ${data.title}`,...data.steps],correct?'Has aplicado correctamente el método. Puedes intentar otro problema.':`La respuesta correcta es ${data.x} ${data.u}. Revisa el procedimiento y vuelve a intentarlo.`,data.d);}}
    };
    let current='force'; const form=document.getElementById('calculator'), result=document.getElementById('result');
    const fmt=n=>Number(n).toLocaleString('es-ES',{maximumSignificantDigits:7}); const sci=n=>Number(n).toExponential(4).replace('e-',' × 10⁻').replace('e+',' × 10⁺');
    function diagramSvg(type){const resistor=(x,y,label)=>`<rect class="resistor" x="${x}" y="${y}" width="70" height="38"/><text x="${x+22}" y="${y+25}">${label}</text>`; if(type==='series')return `<svg viewBox="0 0 720 200" role="img" aria-label="Tres resistencias conectadas en serie"><path class="wire" d="M32 92H135M205 92H260M330 92H385M455 92H690"/>${resistor(135,73,'R1')}${resistor(260,73,'R2')}${resistor(385,73,'R3')}<text x="12" y="100" font-size="25">+</text><text x="695" y="100" font-size="25">−</text><text x="304" y="166" font-size="18">Corriente I</text></svg>`; if(type==='parallel')return `<svg viewBox="0 0 720 250" role="img" aria-label="Tres resistencias conectadas en paralelo"><path class="wire" d="M55 35V215M665 35V215M55 45H250M320 45H665M55 125H250M320 125H665M55 205H250M320 205H665"/>${resistor(250,26,'R1')}${resistor(250,106,'R2')}${resistor(250,186,'R3')}<text x="18" y="132" font-size="25">+</text><text x="680" y="132" font-size="25">−</text></svg>`; if(type==='mixed')return `<svg viewBox="0 0 720 280" role="img" aria-label="Circuito mixto con R1 y R4 en serie y R2 y R3 en paralelo"><path class="wire" d="M32 130H115M185 130H255V52H305M375 52H475V130H510M580 130H690M255 130V208H305M375 208H475V130"/>${resistor(115,111,'R1')}${resistor(305,33,'R2')}${resistor(305,189,'R3')}${resistor(510,111,'R4')}<text x="12" y="138" font-size="25">+</text><text x="695" y="138" font-size="25">−</text></svg>`; if(type==='ohm')return `<svg viewBox="0 0 720 200" role="img" aria-label="Circuito para aplicar la Ley de Ohm"><path class="wire" d="M42 92H295M365 92H680"/>${resistor(295,73,'R')}<text x="15" y="100" font-size="25">+</text><text x="686" y="100" font-size="25">−</text><text x="470" y="68" font-size="18">I →</text></svg>`;return type;}
    function output(answer,steps,note,diagram){return `<h3>Resultado</h3><p class="answer">${answer}</p><h3>Procedimiento</h3><ol class="steps">${steps.map(s=>`<li>${s}</li>`).join('')}</ol><p class="note">${note}</p><div class="diagram" aria-label="Esquema visual">${diagramSvg(diagram)}</div>`;}
    function render(){const t=tools[current]; document.getElementById('formTitle').textContent=t.title; document.getElementById('formula').textContent=t.formula; form.innerHTML=`<div class="fields">${t.fields.map(([id,label,placeholder,type,options])=>`<label>${label}${type==='select'?`<select name="${id}" required>${options.map(o=>`<option value="${o[0]}">${o[1]}</option>`).join('')}</select>`:`<input name="${id}" type="number" step="any" placeholder="${placeholder}" required>`}${placeholder?'<span class="hint">Acepta notación científica, p. ej. 2e-6</span>':''}</label>`).join('')}</div><button class="calculate" type="submit">Calcular resultado</button>`; result.innerHTML='<div class="placeholder">Completa los datos en unidades del SI y calcula para ver el desarrollo paso a paso.</div>'; }
    form.addEventListener('submit',e=>{e.preventDefault(); const t=tools[current], v={}; let invalid=false; t.fields.forEach(([id,,,,])=>{const el=form.elements[id]; v[id]=el.tagName==='SELECT'?el.value:Number(el.value); if(el.tagName!=='SELECT'&&(!Number.isFinite(v[id])||v[id]<=0&&id!=='q1'&&id!=='q2'&&id!=='q'&&id!=='qc'&&id!=='ql'&&id!=='qr')) invalid=true; if(['r','rl','rr','f','r1','r2','r3','b'].includes(id)&&v[id]<=0) invalid=true;}); if(invalid){result.innerHTML='<div class="error">Revisa los datos: usa números válidos y valores positivos para distancias, fuerza, resistencias y divisores.</div>';return;} try{result.innerHTML=t.calc(v);}catch{result.innerHTML='<div class="error">No fue posible realizar el cálculo. Revisa los valores ingresados.</div>';}});
    document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');const c=b.dataset.area==='coulomb';document.getElementById('coulombTools').hidden=!c;document.getElementById('circuitTools').hidden=c;current=c?'force':'series';document.querySelectorAll('.tool').forEach(x=>x.classList.toggle('active',x.dataset.tool===current));render();}));
    document.querySelectorAll('.tool').forEach(b=>b.addEventListener('click',()=>{current=b.dataset.tool;document.querySelectorAll('.tool').forEach(x=>x.classList.toggle('active',x===b));render();})); render();
  </script>
</body>
</html>
